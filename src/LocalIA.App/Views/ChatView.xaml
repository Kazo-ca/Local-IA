<UserControl x:Class="LocalIA.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LocalIA.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Chat / Test de modèle" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Sélection du moteur / modèle -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Moteur :" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="120" ItemsSource="{Binding EngineOptions}" SelectedItem="{Binding SelectedEngine}" Margin="0,0,16,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EngineKindToLabelConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Modèle :" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="320" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" Margin="0,0,8,0" />
            <Button Content="↻" Width="28" Command="{Binding RefreshAvailableModelsCommand}" ToolTip="Rafraîchir la liste des modèles" Margin="0,0,16,0" />

            <Button Content="Vider la conversation" Command="{Binding ClearConversationCommand}" Padding="10,4" />
        </StackPanel>

        <!-- Prompt système optionnel -->
        <Expander Grid.Row="2" Header="Invite système (optionnelle)" Margin="0,0,0,8">
            <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Padding="6" Margin="0,6,0,0" />
        </Expander>

        <!-- Conversation -->
        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
            <ScrollViewer x:Name="MessagesScrollViewer" Padding="12" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <Grid Margin="0,4" HorizontalAlignment="{Binding Role, Converter={StaticResource ChatRoleToAlignmentConverter}}">
                                <Border Background="{Binding Role, Converter={StaticResource ChatRoleToBrushConverter}}"
                                        CornerRadius="10" Padding="12,8" MaxWidth="640">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                   Foreground="{Binding Role, Converter={StaticResource ChatRoleToForegroundConverter}}" />
                                        <TextBlock Text="…" FontWeight="Bold"
                                                   Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibleConverter}}"
                                                   Foreground="{Binding Role, Converter={StaticResource ChatRoleToForegroundConverter}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding PerfStats}" Foreground="Gray" FontSize="11" Margin="0,0,0,4"
                   Visibility="{Binding PerfStats, Converter={StaticResource NullToCollapsedConverter}}" />

        <!-- Saisie -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputTextBox" Grid.Column="0" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" Padding="8" VerticalContentAlignment="Center"
                     PreviewKeyDown="InputTextBox_PreviewKeyDown" />
            <Button Grid.Column="1" Content="Envoyer" Command="{Binding SendCommand}" Padding="16,8" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Arrêter" Command="{Binding StopGenerationCommand}" Padding="16,8" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
