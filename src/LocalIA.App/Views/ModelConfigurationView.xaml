<UserControl x:Class="LocalIA.App.Views.ModelConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cfg="clr-namespace:LocalIA.App.Configuration"
             xmlns:coreconfig="clr-namespace:LocalIA.Core.Configuration;assembly=LocalIA.Core"
             xmlns:views="clr-namespace:LocalIA.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="GpuLayerModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="coreconfig:GpuLayerMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EngineKindValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}" xmlns:sys="clr-namespace:System;assembly=mscorlib"
                             xmlns:coremodels="clr-namespace:LocalIA.Core.Models;assembly=LocalIA.Core">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="coremodels:EngineKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type cfg:SettingsFieldDescriptor}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSet}" IsEnabled="{Binding SupportedByCurrentEngine}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Opacity="{Binding SupportedByCurrentEngine, Converter={StaticResource BoolToOpacityConverter}}" />
                <TextBox Grid.Column="2" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}"
                         Visibility="{Binding IsTextLike, Converter={StaticResource BoolToVisibleConverter}}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="2" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsEditable}" Content="activé"
                          Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibleConverter}}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding EnumOptions}" SelectedItem="{Binding EnumValue}" IsEnabled="{Binding IsEditable}"
                          Visibility="{Binding IsEnum, Converter={StaticResource BoolToVisibleConverter}}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding FlagHint}" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="GroupScroller" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="12" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0">
                <Run Text="Configuration : " />
                <Run Text="{Binding Tier.Label, TargetNullValue='(aucun palier sélectionné)'}" />
            </TextBlock>
            <TextBlock Text="Moteur :" VerticalAlignment="Center" Margin="0,0,6,0"
                       Visibility="{Binding Tier, Converter={StaticResource NullToCollapsedConverter}}" />
            <ComboBox x:Name="EngineCombo" Width="120" ItemsSource="{Binding Source={StaticResource EngineKindValues}}"
                      SelectedItem="{Binding Tier.Engine}" SelectionChanged="EngineCombo_SelectionChanged"
                      Visibility="{Binding Tier, Converter={StaticResource NullToCollapsedConverter}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EngineKindToLabelConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TabControl Grid.Row="1" Visibility="{Binding Tier, Converter={StaticResource NullToCollapsedConverter}}">
            <TabItem Header="Sampling">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding SamplingFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Contexte &amp; Mémoire">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding ContextMemoryFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="GPU &amp; Offload">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <StackPanel>
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Couches GPU (-ngl / num_gpu)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="140" ItemsSource="{Binding Source={StaticResource GpuLayerModeValues}}"
                                              SelectedItem="{Binding Tier.Settings.GpuOffload.GpuLayers.Mode}" Margin="0,0,10,0" />
                                    <TextBox Width="100" Text="{Binding Tier.Settings.GpuOffload.GpuLayers.ExplicitCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Content="Configurer le placement des experts MoE →" Command="{Binding OpenMoePageCommand}"
                                        HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsLlamaCppEngine, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Button Content="Démarrer llama.cpp avec cette configuration" Command="{Binding StartLlamaCppCommand}"
                                            IsEnabled="{Binding IsStartingLlamaCpp, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="8,4" />
                                    <TextBlock Text="Démarrage en cours…" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding IsStartingLlamaCpp, Converter={StaticResource BoolToVisibleConverter}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsLlamaCppExecutableMissing, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Button Content="Installer llama.cpp…" Command="{Binding InstallLlamaCppCommand}"
                                            IsEnabled="{Binding IsInstallingLlamaCpp, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="8,4" />
                                    <TextBlock Text="Installation en cours…" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding IsInstallingLlamaCpp, Converter={StaticResource BoolToVisibleConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LlamaCppStatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="500" HorizontalAlignment="Left"
                                           Visibility="{Binding LlamaCppStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding GpuOffloadFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Réseau &amp; Serveur">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding ServerNetworkingFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Multimodal">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding MultimodalFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Décodage spéculatif">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding SpeculativeDecodingFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Raisonnement">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding ReasoningFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Adaptateurs">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <ItemsControl ItemsSource="{Binding AdapterFields}" ItemTemplate="{StaticResource FieldTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Avancé / Brut">
                <ScrollViewer Style="{StaticResource GroupScroller}">
                    <StackPanel>
                        <TextBlock Text="Arguments CLI llama.cpp supplémentaires" FontSize="12" Foreground="Gray" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Tier.Settings.Raw.ExtraLlamaCppArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                        <TextBlock Text="Paramètres Ollama supplémentaires (un par ligne : « clé valeur »)" FontSize="12" Foreground="Gray" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Tier.Settings.Raw.ExtraOllamaParameters, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding Tier, Converter={StaticResource NullToCollapsedConverter}}">
            <views:ConfigurationAdvisorView DataContext="{Binding Advisor}" />
        </Grid>

        <GroupBox Grid.Row="3" Margin="0,12,0,0">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Aperçu (généré automatiquement)" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Rafraîchir" Command="{Binding RefreshPreviewCommand}" Padding="6,1" FontSize="10" />
                </StackPanel>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding GeneratedPreview}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
