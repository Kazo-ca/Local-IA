<UserControl x:Class="LocalIA.App.Views.MoeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LocalIA.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1050">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,0,0,4">
                <Run Text="MoE : placement des experts en VRAM" />
            </TextBlock>
            <TextBlock Foreground="Gray" Margin="0,0,0,12"
                       Visibility="{Binding TierLabel, Converter={StaticResource NullToCollapsedConverter}}">
                <Run Text="Palier lié : " /><Run Text="{Binding TierLabel}" FontWeight="SemiBold" />
            </TextBlock>

            <!-- Sélection du fichier -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Fichier GGUF" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding GgufFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Parcourir…" Command="{Binding BrowseFileCommand}" Padding="10,4" />
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="DarkOrange" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding Metadata, Converter={StaticResource NullToCollapsedConverter}}">
                <!-- Infos modèle -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">
                            <Run Text="{Binding Metadata.Architecture}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Metadata.QuantizationLabel}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Metadata.ExpertCount}" /><Run Text=" experts (" />
                            <Run Text="{Binding Metadata.ExpertUsedCount}" /><Run Text=" actifs/token)" />
                        </TextBlock>
                        <TextBlock Foreground="Gray" FontSize="12">
                            <Run Text="Couches MoE : " /><Run Text="{Binding Recommendation.TotalMoeLayers}" />
                            <Run Text=" · Contexte entraîné : " /><Run Text="{Binding Metadata.ContextLengthTrained}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Paramètres du calcul -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Budget VRAM" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="VRAM disponible (Mio)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AvailableVramMiB, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Marge de sécurité (Mio)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SafetyMarginMiB, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Taille de contexte" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ContextSize, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Recalculer" Command="{Binding RecalculateCommand}" Padding="10,5" Margin="0,0,8,0" />
                            <Button Content="Appliquer la recommandation" Command="{Binding ApplyRecommendationCommand}" Padding="10,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recommandation -->
                <Border Style="{StaticResource CardBorder}"
                        Visibility="{Binding Recommendation, Converter={StaticResource NullToCollapsedConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Recommendation.FitsInBudget, Converter={StaticResource BoolToFitBrushConverter}}" />
                            <TextBlock Text="Recommandation" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Recommendation.Explanation}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Curseur simple / grille avancée -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Couches d'experts sur CPU" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <ToggleButton Content="Mode avancé (par couche)" IsChecked="{Binding IsAdvancedMode}" Padding="8,3" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource InverseBoolToVisibleConverter}}">
                            <Slider Minimum="0" Maximum="{Binding Recommendation.TotalMoeLayers}" Value="{Binding SimpleSliderValue}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="{Binding SimpleSliderValue}" FontWeight="SemiBold" />
                                <Run Text=" première(s) couche(s) d'experts sur CPU (" />
                                <Run Text="{Binding Recommendation.TotalMoeLayers}" />
                                <Run Text=" au total)." />
                            </TextBlock>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding LayerRows}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MoeLayerRowViewModel}">
                                    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsOnGpu}" ToolTip="Coché = sur GPU, décoché = sur CPU" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Index}" FontFamily="Consolas" Width="24" />
                                            <TextBlock Text="{Binding SizeBytes, Converter={StaticResource BytesToGigabytesConverter}}" FontSize="10" Foreground="Gray" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Aperçu -->
                <GroupBox Header="Aperçu (généré automatiquement)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                        <TextBlock Text="{Binding GeneratedArgsPreview}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </ScrollViewer>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
