<UserControl x:Class="LocalIA.App.Views.HuggingFaceSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LocalIA.App.ViewModels"
             xmlns:hf="clr-namespace:LocalIA.Core.HuggingFace;assembly=LocalIA.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050">
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Recherche Hugging Face" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Foreground="Gray" Margin="0,32,0,8" VerticalAlignment="Top"
                   Visibility="{Binding LastAddedTierLabel, Converter={StaticResource NullToCollapsedConverter}}">
            <Run Text="Dernier modèle ajouté (cible des attachements) : " /><Run Text="{Binding LastAddedTierLabel}" FontWeight="SemiBold" />
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" FontSize="14" />
            <TextBlock Grid.Column="1" Text="Recherche…" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibleConverter}}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Résultats de recherche -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedModel}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type hf:HfModelSummary}">
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <Run Text="{Binding Downloads, StringFormat='{}{0:N0} téléchargements'}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Likes, StringFormat='{}{0} ♥'}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Fichiers du dépôt sélectionné -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                    Visibility="{Binding SelectedModel, Converter={StaticResource NullToCollapsedConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedModel.Id}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="Chargement des fichiers…" Foreground="Gray" Margin="0,0,0,8"
                               Visibility="{Binding IsLoadingFiles, Converter={StaticResource BoolToVisibleConverter}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Modèle principal (choisir une quantification)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding RepoFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HfFileRowViewModel}">
                                        <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="10" Foreground="Gray"
                                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <Run Text="Progression : " /><Run Text="{Binding DownloadProgressPercent, StringFormat={}{0:0}%}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding QuantLabel}" FontFamily="Consolas" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={StaticResource BytesToGigabytesConverter}}"
                                                           Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Button Grid.Column="3" Content="Télécharger" Command="{Binding DataContext.DownloadNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="8,3" Margin="0,0,4,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                    <Button Content="+ llama.cpp" Command="{Binding DataContext.AddToLlamaCppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,3" Margin="0,0,4,0" />
                                                    <Button Content="+ Ollama" Command="{Binding DataContext.AddToOllamaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,3" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding AuxiliaryFiles.Count, Converter={StaticResource CountToVisibleConverter}}"
                                        Margin="0,16,0,0">
                                <TextBlock Text="Fichiers complémentaires détectés dans ce dépôt" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Text="Associez-les à un modèle principal déjà ajouté ci-dessus (bouton « + llama.cpp »)." FontSize="11" Foreground="Gray" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AuxiliaryFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HfFileRowViewModel}">
                                            <Border Background="#F5F8FF" BorderBrush="#D6E0F5" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="{Binding RoleDisplayName, Mode=OneWay}" />
                                                            <Run Text=" — " /><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="Normal" FontFamily="Consolas" FontSize="11" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding RoleDescription}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />
                                                        <TextBlock FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibleConverter}}">
                                                            <Run Text="Progression : " /><Run Text="{Binding DownloadProgressPercent, StringFormat={}{0:0}%}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource BytesToGigabytesConverter}}"
                                                               Foreground="Gray" VerticalAlignment="Top" />
                                                    <Button Grid.Column="2" Content="Attacher" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.AttachAuxiliaryFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="10,4"
                                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
    </Grid>
</UserControl>
